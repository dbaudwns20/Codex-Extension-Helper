{
  "name": "codex-extension-helper",
  "displayName": "Codex Extension Helper",
  "description": "Show external file changes inline in VS Code editors.",
  "version": "0.0.2",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "publisher": "local",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexExtensionHelper.openDiff",
        "title": "Codex Changes: Open Full Diff"
      },
      {
        "command": "codexExtensionHelper.approveHunk",
        "title": "Codex Changes: Approve Change"
      },
      {
        "command": "codexExtensionHelper.rejectHunk",
        "title": "Codex Changes: Reject Change"
      },
      {
        "command": "codexExtensionHelper.previousChange",
        "title": "Codex Changes: Previous Change",
        "icon": "$(arrow-up)"
      },
      {
        "command": "codexExtensionHelper.nextChange",
        "title": "Codex Changes: Next Change",
        "icon": "$(arrow-down)"
      },
      {
        "command": "codexExtensionHelper.approveAll",
        "title": "Codex Changes: Approve All",
        "icon": "$(check-all)"
      },
      {
        "command": "codexExtensionHelper.rejectAll",
        "title": "Codex Changes: Reject All",
        "icon": "$(discard)"
      },
      {
        "command": "codexExtensionHelper.insertExplorerPathIntoCodex",
        "title": "Codex: Add as @ Mention",
        "enablement": "isMac"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codexExtensionHelper.previousChange",
          "when": "resourceScheme == file && codexExtensionHelper.activeFileHasChanges",
          "group": "navigation@10"
        },
        {
          "command": "codexExtensionHelper.nextChange",
          "when": "resourceScheme == file && codexExtensionHelper.activeFileHasChanges",
          "group": "navigation@11"
        },
        {
          "command": "codexExtensionHelper.approveAll",
          "when": "resourceScheme == file && codexExtensionHelper.activeFileHasChanges",
          "group": "navigation@20"
        },
        {
          "command": "codexExtensionHelper.rejectAll",
          "when": "resourceScheme == file && codexExtensionHelper.activeFileHasChanges",
          "group": "navigation@21"
        }
      ],
      "explorer/context": [
        {
          "command": "codexExtensionHelper.insertExplorerPathIntoCodex",
          "when": "resourceScheme == file && isMac",
          "group": "codex@1"
        }
      ]
    },
    "configuration": {
      "title": "Codex Extension Helper",
      "properties": {
        "codexExtensionHelper.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline rendering of external file changes."
        },
        "codexExtensionHelper.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 50,
          "maximum": 5000,
          "description": "Milliseconds to wait before comparing an external file change."
        },
        "codexExtensionHelper.maxFileSizeKb": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "description": "Maximum file size in KiB eligible for inline change rendering."
        },
        "codexExtensionHelper.exclude": {
          "type": "array",
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns for files excluded from inline change rendering."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . && node ./scripts/build-extension.mjs",
    "watch": "node ./scripts/watch-extension.mjs",
    "patch:codex-drop": "node ./scripts/patch-codex-drop.mjs",
    "unpatch:codex-drop": "node ./scripts/unpatch-codex-drop.mjs",
    "test": "vitest",
    "test:unit": "vitest run test/unit",
    "test:extension": "npm run compile && node ./out/test/extension/runTest.js",
    "check": "npm run compile && npm run test:unit",
    "package": "npm run check && vsce package --no-dependencies"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "minimatch": "^10.0.3"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.105.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.21.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
